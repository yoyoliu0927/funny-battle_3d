extends "res://levels/ice/rescue_world.gd"
## 【冰雪島 4 排隊】阿土、阿水一前一後走同一條紅線；往東滑的路上依序是雪人、冰洞。
## 雪人只擋第一個人：第一片讓阿土撞倒雪人暈在線上，第二片讓阿水滑過去把他一起推進冰洞。守衛在北邊、薄冰在他南邊。

func _ice_configure() -> void:
	# ==================================================================
	# 【玩法】（關卡設定線負責）：範圍、湖、冰洞、薄冰、雪人、雪堆、松樹、籠子、家豪起點、黃線。
	#   這一段的每個數字都掃過線，改了要重掃（見 levels/ice/docs/關卡規格.md 第 3 節「要確認」）。
	# ==================================================================
	play_min = Vector2(-20.0, -23.0)
	play_max = Vector2(20.0, 18.0)
	hero_start = Vector3(0.0, 0.0, 9.5)
	cage = Vector3(0.0, 0.0, -11.8)
	bird_path = [Vector3(0.0, 0, 6.0), Vector3(0.0, 0, -9.4)]
	# 湖偏東：紅線只有東邊約 4 公尺在冰上
	lakes = [{"center": Vector2(3.5, -3.0), "rx": 9.0, "rz": 7.5}]
	ponds = [{"center": Vector2(7.5, -2.0), "r": 1.4}]
	thin_spots = [{"center": Vector2(2.1, -5.15), "r": 1.1}]
	snowmen = [Vector3(4.0, 0, -2.0)]
	pines = [Vector3(-7.0, 0, -12.5), Vector3(7.0, 0, -12.5), Vector3(12.5, 0, 2.0)]
	# ==================================================================
	# 【外觀】（環境代理負責）：mood、isle、zones、camps、clear_paths、鏡頭 camera_*。
	#   目前是從 stage_9 複製來、能跑的暫時值；不影響玩法。
	# ==================================================================
	camera_start = Vector3(-1.0, 11.0, 20.3)      # 鏡頭往西偏一點：西岸的漁村才整個在畫面裡
	camera_look = Vector3(-1.0, -2.6, -1.2)       # y 只用來調俯角：家豪腳下留一點空間
	camera_fov = 45.0
	mood = "morning"
	# ---- 以下都是外觀（不影響玩法）
	# 地圖的輪廓：南邊（鏡頭這一側）收短一點；coves 是岸邊凹進來的小海灣（看得到對面的冰崖）
	isle = {"seed": 1.3, "c": Vector2(0.0, -4.0), "rz": 19.5,
		"coves": [[0.05, 5.0, 0.13], [-1.20, 4.5, 0.12], [-1.98, 4.5, 0.12], [3.40, 4.5, 0.12]]}
	# 裝飾要讓開的路線（工人的紅線）
	clear_paths = [[Vector3(-10.8, 0, -2.0), Vector3(-1.2, 0, -2.0), Vector3(7.5, 0, -2.0)]]
	# 工人的冰釣營地（裝飾）：在他們出發點後面
	camps = [{"pos": Vector3(-14.5, 0, -14.5), "yaw": 0.9}, {"pos": Vector3(13.5, 0, -16.0), "yaw": -0.7}]
	# 冰湖周圍的擺設（純裝飾）。高的東西都離冰洞 9 公尺以上：過關特寫的鏡頭會繞著冰洞拍
	front_props = false
	zones = [
		# 這一關的地標：西岸的碼頭漁村——伸進湖裡的棧道、一排三間小屋、拖上岸的漁船、曬著的漁網
		{"type": "pier", "pos": Vector3(-8.6, 0, 0.0), "yaw": -1.57},
		{"type": "village", "pos": Vector3(-12.6, 0, -3.6), "yaw": 1.57, "huts": [[0.0, 0.0, 0.0, 1.1], [-0.5, -3.4, -0.25, 1.0], [-0.3, 6.0, 0.3, 0.9]]},
		{"type": "boat", "pos": Vector3(-10.4, 0, 2.3), "yaw": 0.25},
		{"type": "net", "pos": Vector3(-10.0, 0, 5.0), "yaw": 1.3},
		# 漁村延伸到家豪出發點附近：一艘拖上岸的小船、一堆魚貨、曬魚架（避開左下的道具格和右下的開始鈕）
		{"type": "boat", "pos": Vector3(-5.0, 0, 10.6), "yaw": 1.0, "tilt": -0.14, "scale": 0.95},
		{"type": "crates", "pos": Vector3(3.6, 0, 10.4), "yaw": 0.3},
		{"type": "rack", "pos": Vector3(5.6, 0, 9.2), "yaw": -0.4},
		{"type": "crystals", "pos": Vector3(14.5, 0, -9.5)},
		{"type": "creek", "from": Vector3(16.5, 0, -17.0), "to": Vector3(8.6, 0, -5.2)},
	]
