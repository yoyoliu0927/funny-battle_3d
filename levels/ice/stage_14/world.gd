extends "res://levels/ice/rescue_world.gd"
## 【冰雪島 4 排隊】阿土、阿水一前一後走同一條紅線；往東滑的路上依序是雪人、冰洞。
## 雪人只擋第一個人：第一片讓阿土撞倒雪人暈在線上，第二片讓阿水滑過去把他一起推進冰洞。守衛在北邊、薄冰在他南邊。

func _ice_configure() -> void:
	# ==================================================================
	# 【玩法】（關卡設定線負責）：範圍、湖、冰洞、薄冰、雪人、雪堆、松樹、籠子、家豪起點、黃線。
	#   這一段的每個數字都掃過線，改了要重掃（見 levels/ice/docs/關卡規格.md 第 3 節「要確認」）。
	# ==================================================================
	play_min = Vector2(-20.0, -23.0)
	play_max = Vector2(20.0, 18.0)
	hero_start = Vector3(0.0, 0.0, 9.5)
	cage = Vector3(0.0, 0.0, -11.8)
	bird_path = [Vector3(0.0, 0, 6.0), Vector3(0.0, 0, -9.4)]
	# 湖偏東：紅線只有東邊約 4 公尺在冰上
	lakes = [{"center": Vector2(3.5, -3.0), "rx": 9.0, "rz": 7.5}]
	ponds = [{"center": Vector2(7.5, -2.0), "r": 1.4}]
	thin_spots = [{"center": Vector2(2.1, -5.15), "r": 1.1}]
	# 雪人往北偏 0.4：照樣擋住線上的第一個人；倒了以後中心 0.2 公尺內還會卡人，偏開才滑得過去
	snowmen = [Vector3(4.0, 0, -2.4)]
	pines = [Vector3(-7.0, 0, -12.5), Vector3(7.0, 0, -12.5), Vector3(12.5, 0, 2.0)]
	# ==================================================================
	# 【外觀】（環境代理負責）：mood、isle、zones、camps、clear_paths、鏡頭 camera_*。不影響玩法。
	# ==================================================================
	camera_start = Vector3(-0.5, 11.0, 20.3)
	camera_look = Vector3(-0.5, -2.6, -1.2)       # y 只用來調俯角：家豪腳下留一點空間
	camera_fov = 45.0
	mood = "golden"                               # 金色傍晚：金黃的斜陽、藍色的長影子
	isle = {"seed": 5.7, "c": Vector2(0.0, -4.0), "rz": 19.5,
		"coves": [[0.05, 5.0, 0.13], [-1.20, 4.5, 0.12], [-1.98, 4.5, 0.12], [3.50, 4.5, 0.12]]}
	# 裝飾要讓開的路線（工人的紅線和滑出去的方向、守衛撲的方向）
	clear_paths = [[Vector3(-10.8, 0, -2.0), Vector3(-1.2, 0, -2.0), Vector3(7.5, 0, -2.0)], [Vector3(1.5, 0, -6.5), Vector3(2.7, 0, -3.8)]]
	camps = [{"pos": Vector3(-14.5, 0, -11.5), "yaw": 0.9}, {"pos": Vector3(13.5, 0, -16.0), "yaw": -0.7}]
	# 冰湖周圍的擺設（純裝飾）。高的東西都離冰洞、薄冰 9 公尺以上：過關特寫的鏡頭會繞著拍
	front_props = false
	zones = [
		# 這一關的地標：西南岸的燈塔——紅白條紋的塔站在石頭上，旁邊一間看守小屋、一艘船
		{"type": "lighthouse", "pos": Vector3(-10.6, 0, 4.4), "yaw": 0.4},
		{"type": "village", "pos": Vector3(-13.2, 0, 0.6), "yaw": 1.57, "huts": [[0.0, 0.0, 0.2, 0.95]]},
		{"type": "boat", "pos": Vector3(-7.6, 0, 6.6), "yaw": 1.1, "tilt": 0.12},
		{"type": "lantern", "pos": Vector3(-7.4, 0, 3.2)},
		# 延伸到家豪出發點附近：魚貨、曬魚架、一艘小船（避開左下的道具格、右下的開始鈕、黃線）
		{"type": "crates", "pos": Vector3(-4.6, 0, 9.8), "yaw": 0.3},
		{"type": "rack", "pos": Vector3(4.4, 0, 9.6), "yaw": -0.4},
		{"type": "boat", "pos": Vector3(6.0, 0, 11.0), "yaw": -0.9, "tilt": -0.12, "scale": 0.9},
		{"type": "crystals", "pos": Vector3(-13.5, 0, -6.5)},
		{"type": "creek", "from": Vector3(16.5, 0, -17.0), "to": Vector3(10.4, 0, -8.2)},
	]
